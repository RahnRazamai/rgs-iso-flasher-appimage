#!/usr/bin/env bash
set -euo pipefail

ISO=""
DEVICE=""
MODE="auto"

log() {
  echo "[RGS ISO Flasher] $*"
}

die() {
  echo "ERROR: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Missing dependency: $1"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --iso)
      ISO="$2"
      shift 2
      ;;
    --device)
      DEVICE="$2"
      shift 2
      ;;
    --mode)
      MODE="$2"
      shift 2
      ;;
    *)
      die "Unknown arg: $1"
      ;;
  esac
done

[[ -f "$ISO" ]] || die "ISO file not found: $ISO"
[[ -b "$DEVICE" ]] || die "Target device is not a block device: $DEVICE"

case "$MODE" in
  auto|windows|raw) ;;
  *) die "Invalid mode: $MODE" ;;
esac

need_cmd lsblk
need_cmd umount
need_cmd sync

log "ISO: $ISO"
log "Device: $DEVICE"
log "Mode: $MODE"

detect_windows_iso() {
  local mount_dir
  mount_dir="$(mktemp -d)"

  mount -o loop,ro "$ISO" "$mount_dir"

  if [[ -d "$mount_dir/sources" ]] || [[ -d "$mount_dir/SOURCES" ]]; then
    umount "$mount_dir"
    rmdir "$mount_dir"
    return 0
  fi

  umount "$mount_dir"
  rmdir "$mount_dir"
  return 1
}

unmount_device_partitions() {
  log "Unmounting existing partitions..."

  while read -r part; do
    [[ -n "$part" ]] || continue
    umount "$part" 2>/dev/null || true
  done < <(lsblk -ln -o PATH "$DEVICE" | tail -n +2)
}

flash_raw() {
  need_cmd dd

  unmount_device_partitions

  log "Writing ISO using raw dd..."
  dd if="$ISO" of="$DEVICE" bs=4M status=progress conv=fsync

  sync
  log "Raw flashing completed."
}

flash_windows() {
  need_cmd parted
  need_cmd mkfs.vfat
  need_cmd rsync
  need_cmd mount
  need_cmd wimlib-imagex

  local iso_mount
  local usb_mount
  local part

  iso_mount="$(mktemp -d)"
  usb_mount="$(mktemp -d)"

  cleanup() {
    if [[ -n "${iso_mount:-}" ]]; then
      umount "$iso_mount" 2>/dev/null || true
      rmdir "$iso_mount" 2>/dev/null || true
    fi

    if [[ -n "${usb_mount:-}" ]]; then
      umount "$usb_mount" 2>/dev/null || true
      rmdir "$usb_mount" 2>/dev/null || true
    fi
  }

  trap cleanup EXIT

  unmount_device_partitions

  log "Creating GPT partition table..."
  parted -s "$DEVICE" mklabel gpt
  parted -s "$DEVICE" mkpart primary fat32 1MiB 100%
  parted -s "$DEVICE" set 1 boot on
  parted -s "$DEVICE" set 1 esp on

  sync
  sleep 2
  partprobe "$DEVICE" 2>/dev/null || true
  sleep 2

  if [[ "$DEVICE" =~ nvme|mmcblk ]]; then
    part="${DEVICE}p1"
  else
    part="${DEVICE}1"
  fi

  [[ -b "$part" ]] || die "Partition not found after formatting: $part"

  log "Formatting USB partition as FAT32..."
  mkfs.vfat -F 32 -n RGSUSB "$part"

  log "Mounting ISO and USB..."
  mount -o loop,ro "$ISO" "$iso_mount"
  mount "$part" "$usb_mount"

  log "Copying Windows installer files except install.wim..."
  rsync -rtv --info=progress2 \
    --no-owner \
    --no-group \
    --no-perms \
    --modify-window=1 \
    --exclude='sources/install.wim' \
    --exclude='sources/INSTALL.WIM' \
    "$iso_mount"/ "$usb_mount"/

  local wim=""
  if [[ -f "$iso_mount/sources/install.wim" ]]; then
    wim="$iso_mount/sources/install.wim"
  elif [[ -f "$iso_mount/sources/INSTALL.WIM" ]]; then
    wim="$iso_mount/sources/INSTALL.WIM"
  fi

  if [[ -n "$wim" ]]; then
    log "Splitting install.wim into FAT32-compatible SWM files..."
    mkdir -p "$usb_mount/sources"
    wimlib-imagex split "$wim" "$usb_mount/sources/install.swm" 3800
  else
    log "No install.wim found. Skipping WIM split."
  fi

  sync
  log "Windows USB creation completed."
}

if [[ "$MODE" == "raw" ]]; then
  flash_raw
elif [[ "$MODE" == "windows" ]]; then
  flash_windows
else
  if detect_windows_iso; then
    log "Detected Windows installer ISO."
    flash_windows
  else
    log "Detected non-Windows ISO."
    flash_raw
  fi
fi

log "Done."
