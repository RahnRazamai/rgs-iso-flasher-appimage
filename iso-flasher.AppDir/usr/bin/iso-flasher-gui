#!/usr/bin/env python3
import os
import re
import json
import shutil
import subprocess
import tempfile
import threading
import queue
import tkinter as tk
from tkinter import ttk, filedialog, messagebox

APP_TITLE = "RGS ISO Flasher"
APP_ID = "rgs-iso-flasher"


class FlasherGUI(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title(APP_TITLE)
        self.geometry("820x600")
        self.resizable(True, True)
        self.proc = None
        self.q = queue.Queue()
        self.dev_map = {}
        self.create_widgets()
        self.refresh_devices()
        self.after(100, self.drain_queue)

    def create_widgets(self):
        pad = {"padx": 10, "pady": 6}

        main = ttk.Frame(self)
        main.pack(fill="both", expand=True)

        title = ttk.Label(main, text="RGS ISO Flasher", font=("TkDefaultFont", 18, "bold"))
        title.grid(row=0, column=0, columnspan=3, sticky="w", **pad)

        subtitle = ttk.Label(main, text="Create bootable USB drives from Windows or Linux ISO files.")
        subtitle.grid(row=1, column=0, columnspan=3, sticky="w", **pad)

        ttk.Label(main, text="ISO file").grid(row=2, column=0, sticky="w", **pad)
        self.iso_var = tk.StringVar()
        ttk.Entry(main, textvariable=self.iso_var).grid(row=2, column=1, sticky="ew", **pad)
        ttk.Button(main, text="Choose…", command=self.choose_iso).grid(row=2, column=2, sticky="ew", **pad)

        ttk.Label(main, text="Target USB device").grid(row=3, column=0, sticky="w", **pad)
        self.dev_var = tk.StringVar()
        self.dev_combo = ttk.Combobox(main, textvariable=self.dev_var, state="readonly")
        self.dev_combo.grid(row=3, column=1, sticky="ew", **pad)
        ttk.Button(main, text="Refresh", command=self.refresh_devices).grid(row=3, column=2, sticky="ew", **pad)

        ttk.Label(main, text="Mode").grid(row=4, column=0, sticky="w", **pad)
        self.mode_var = tk.StringVar(value="auto")

        mode = ttk.Frame(main)
        mode.grid(row=4, column=1, sticky="w", **pad)
        ttk.Radiobutton(mode, text="Auto", variable=self.mode_var, value="auto").pack(side="left")
        ttk.Radiobutton(mode, text="Windows ISO", variable=self.mode_var, value="windows").pack(side="left", padx=8)
        ttk.Radiobutton(mode, text="Raw dd", variable=self.mode_var, value="raw").pack(side="left", padx=8)

        ttk.Label(main, text="Sudo password").grid(row=5, column=0, sticky="w", **pad)
        self.pass_var = tk.StringVar()
        ttk.Entry(main, textvariable=self.pass_var, show="•").grid(row=5, column=1, sticky="ew", **pad)

        self.confirm_var = tk.BooleanVar(value=False)
        ttk.Checkbutton(
            main,
            variable=self.confirm_var,
            text="I understand the selected USB device will be completely erased"
        ).grid(row=6, column=1, sticky="w", **pad)

        actions = ttk.Frame(main)
        actions.grid(row=7, column=1, sticky="w", **pad)

        self.flash_btn = ttk.Button(actions, text="Flash USB", command=self.start_flash)
        self.flash_btn.pack(side="left")

        ttk.Button(actions, text="Stop", command=self.stop_flash).pack(side="left", padx=8)

        ttk.Label(main, text="Log").grid(row=8, column=0, sticky="nw", **pad)

        self.log = tk.Text(main, height=20, wrap="word")
        self.log.grid(row=8, column=1, columnspan=2, sticky="nsew", **pad)

        main.columnconfigure(1, weight=1)
        main.rowconfigure(8, weight=1)

    def choose_iso(self):
        path = filedialog.askopenfilename(
            title="Choose ISO",
            filetypes=[("ISO images", "*.iso"), ("All files", "*.*")]
        )
        if path:
            self.iso_var.set(path)

    def refresh_devices(self):
        try:
            out = subprocess.check_output(
                ["lsblk", "-J", "-o", "NAME,PATH,SIZE,MODEL,TRAN,TYPE,MOUNTPOINTS"],
                text=True
            )
            data = json.loads(out)

            items = []
            self.dev_map = {}

            for disk in data.get("blockdevices", []):
                if disk.get("type") != "disk":
                    continue

                path = disk.get("path") or f"/dev/{disk.get('name')}"
                model = (disk.get("model") or "Unknown").strip()
                size = disk.get("size", "?")
                tran = disk.get("tran") or "disk"

                label = f"{path} — {size} — {model} — {tran}"
                items.append(label)
                self.dev_map[label] = path

            self.dev_combo["values"] = items

            if items:
                self.dev_combo.current(0)

        except Exception as e:
            messagebox.showerror(APP_TITLE, f"Could not list disks:\n{e}")

    def append_log(self, text):
        self.log.insert("end", text)
        self.log.see("end")

    def validate(self):
        iso = self.iso_var.get().strip()
        selected = self.dev_var.get().strip()
        password = self.pass_var.get()

        if not iso or not os.path.isfile(iso):
            messagebox.showerror(APP_TITLE, "Please choose a valid ISO file.")
            return None

        if not selected or selected not in self.dev_map:
            messagebox.showerror(APP_TITLE, "Please choose a target USB device.")
            return None

        if not password:
            messagebox.showerror(APP_TITLE, "Please enter your sudo password.")
            return None

        if not self.confirm_var.get():
            messagebox.showerror(APP_TITLE, "Please tick the erase confirmation checkbox.")
            return None

        dev = self.dev_map[selected]

        if not re.match(r"^/dev/[a-zA-Z0-9_./-]+$", dev):
            messagebox.showerror(APP_TITLE, "Invalid device path.")
            return None

        return iso, dev, password, self.mode_var.get()

    def prepare_runner(self):
        appdir = os.environ.get("APPDIR")

        if appdir:
            runner_src = os.path.join(appdir, "usr", "bin", "iso-flasher-runner")
        else:
            runner_src = os.path.join(os.path.dirname(__file__), "iso-flasher-runner")

        if not os.path.exists(runner_src):
            raise FileNotFoundError(f"Runner not found: {runner_src}")

        runner_tmp = os.path.join(tempfile.gettempdir(), "rgs-iso-flasher-runner")

        shutil.copy2(runner_src, runner_tmp)

        with open(runner_tmp, "rb") as f:
            content = f.read()

        content = content.replace(b"\r\n", b"\n")

        with open(runner_tmp, "wb") as f:
            f.write(content)

        os.chmod(runner_tmp, 0o755)
        return runner_tmp

    def start_flash(self):
        vals = self.validate()
        if not vals:
            return

        iso, dev, password, mode = vals

        warning = (
            f"This will COMPLETELY ERASE:\n\n{dev}\n\n"
            f"ISO:\n{iso}\n\n"
            "Continue?"
        )

        if not messagebox.askyesno(APP_TITLE, warning):
            return

        self.flash_btn.config(state="disabled")
        self.append_log("\n=== RGS ISO Flasher starting ===\n")

        try:
            runner = self.prepare_runner()
        except Exception as e:
            self.append_log(f"ERROR preparing runner: {e}\n")
            self.flash_btn.config(state="normal")
            return

        cmd = [
            "sudo",
            "-S",
            "-p",
            "",
            runner,
            "--iso",
            iso,
            "--device",
            dev,
            "--mode",
            mode,
        ]

        def worker():
            try:
                inhibit = subprocess.Popen([
                    "systemd-inhibit",
                    "--what=sleep",
                    "--why=RGS ISO Flasher USB write",
                    "sleep",
                    "999999"
                ])

                self.proc = subprocess.Popen(
                    cmd,
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1,
                )

                self.proc.stdin.write(password + "\n")
                self.proc.stdin.flush()
                self.pass_var.set("")

                for line in self.proc.stdout:
                    self.q.put(line)

                rc = self.proc.wait()
                self.q.put(f"\n=== Finished with exit code {rc} ===\n")

            except Exception as e:
                self.q.put(f"ERROR: {e}\n")

            finally:
                try:
                    inhibit.terminate()
                except:
                    pass

                self.q.put(None)

        threading.Thread(target=worker, daemon=True).start()

    def stop_flash(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            self.append_log("\nRequested stop. Device may be left incomplete.\n")

    def drain_queue(self):
        try:
            while True:
                item = self.q.get_nowait()

                if item is None:
                    self.flash_btn.config(state="normal")
                else:
                    self.append_log(item)

        except queue.Empty:
            pass

        self.after(100, self.drain_queue)


if __name__ == "__main__":
    app = FlasherGUI()
    app.mainloop()
